/servidor/.wrangler/
/servidor/.dev.vars

# runtime files when run from the tree
hub_state.toml
/dados/
/cache/
/reports/
/ports/

# editors
.vs/
.vscode/
.idea/

# this development machine's installer (its own paths)
/scripts/instalar-local.cmd
